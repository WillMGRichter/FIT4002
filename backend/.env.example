# Copy to `.env` and fill in real values. Never commit `.env`.
#   cp .env.example .env

# Port the API listens on.
PORT=5001

# Supabase project URL and SERVICE ROLE key (Project Settings -> API).
# The service role key bypasses Row Level Security - keep it server-side only.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# REQUIRED. Secret used to sign and verify login tokens. The server refuses to
# start without it, and rejects well-known placeholder values. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Changing it invalidates every existing token (everyone must log in again).
JWT_SECRET=
