# Copy to `.env` and fill in real values. Never commit `.env`.
#   cp .env.example .env

# Port the API listens on.
PORT=5001

# Supabase project URL and SERVICE ROLE key (Project Settings -> API).
# The service role key bypasses Row Level Security - keep it server-side only.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# REQUIRED. Secret used to sign and verify login tokens. The server refuses to
# start without it, and rejects well-known placeholder values. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Changing it invalidates every existing token (everyone must log in again).
JWT_SECRET=

# --- Optional hardening settings (defaults shown) -----------------------------

# Max size of an uploaded Excel workbook, in MB. Real workbooks are ~20 KB.
# Invalid or non-positive values are ignored (the default is used).
# MAX_UPLOAD_MB=10

# Rate limit for the unauthenticated POST /public/projects/:id/join endpoint,
# counted per client IP. The default is sized so a whole class behind one shared
# school/NAT address can still join together.
# JOIN_RATE_LIMIT_MAX=60
# JOIN_RATE_LIMIT_WINDOW_MS=900000

# Rate limits for the unauthenticated login endpoints. Only FAILED logins count.
# Per account (client IP + username): stops password guessing on one account.
# Per IP: stops one address trying many accounts (higher: a class may share an IP).
# LOGIN_RATE_LIMIT_MAX=10
# LOGIN_IP_RATE_LIMIT_MAX=100
# LOGIN_RATE_LIMIT_WINDOW_MS=900000

# Rate limit for the unauthenticated signup endpoints, per client IP.
# SIGNUP_RATE_LIMIT_MAX=20
# SIGNUP_RATE_LIMIT_WINDOW_MS=3600000

# Number of reverse proxies in front of the API (e.g. 1 behind a single load
# balancer). REQUIRED when hosted behind a proxy, otherwise every user appears to
# share the proxy's IP and rate limiting is wrong. Leave unset for local/LAN use.
# A bare "true" is ignored on purpose: it would let clients spoof their IP.
# TRUST_PROXY=1
